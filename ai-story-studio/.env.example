# AI Story Studio — example environment. Copy to `.env` (never commit `.env`).

# Mock generation is ON by default. While true, no GPU is provisioned, no paid
# API is called and every generated asset is a clearly labelled placeholder.
MOCK_GENERATION=true

# Cloud GPU provisioning (RunPod, Phase 5): a second, independent gate. While false,
# no cloud GPU can ever be rented. See the "Cloud GPU" section at the end of this file.
ENABLE_CLOUD_GPU=false

# Local web UI. Bind to loopback only; this is a private, single-user tool.
HOST=127.0.0.1
PORT=3000

# Where the SQLite database, media assets, logs and backups are stored.
DATA_DIR=./data

# --- Heavy storage on another drive (optional) -------------------------------------------------
# Leave empty to keep everything inside DATA_DIR. Set these once your second drive (e.g. D:) exists;
# nothing is moved automatically: copy the existing folder there first, with the app closed.
# GENERATED_ASSETS_PATH=D:\AI-Story-Studio-Data\storage   # images, clips, audio, finished videos
# TEMP_RENDER_PATH=D:\AI-Story-Studio-Data\tmp            # BUILD FINAL work folders (deleted after each build)
# DOWNLOAD_CACHE_PATH=D:\AI-Story-Studio-Data\downloads   # cloud results while they are validated
# MODEL_CACHE_PATH=D:\AI-Story-Studio-Data\models         # model weights for the optional LOCAL worker only; set it
#                                                          # in the worker's terminal too (cloud GPUs cache on RunPod)

# Probability (0..1) that a mock generation attempt fails, to exercise the
# retry / failure-cleanup paths. 0 disables random mock failures.
MOCK_FAILURE_RATE=0

# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Local AI worker (Phase 2) ---------------------------------------------------
# Leave WORKER_URL empty to use the in-process mock providers. To use the Python
# worker (worker/), start it with `npm run worker` and set both values below.
# The SAME token must be given to the worker process. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_URL=
WORKER_AUTH_TOKEN=
WORKER_TIMEOUT_SEC=1800

# Worker process settings. The worker does NOT read this file: set these as environment variables
# in the terminal that runs `npm run worker` (e.g. PowerShell: $env:WORKER_PORT=8765).
# WORKER_HOST=127.0.0.1
# WORKER_PORT=8765
# WORKER_DATA_DIR=./worker-data
# WORKER_MOCK_MODELS=true
# WORKER_MAX_UPLOAD_MB=64
# WORKER_MAX_CONCURRENT_JOBS=1
# WORKER_JOB_TIMEOUT_SEC=1800
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Phase 3 — real open-source models (see docs/BENCHMARKING.md):
# WORKER_MODELS_FILE=./worker/models.json      # copy of worker/models.example.json, reviewed
# WORKER_MODEL_CACHE_DIR=~/.cache/ais-models   # model downloads
# WORKER_ALLOW_NONCOMMERCIAL=false             # true = private evaluation of non-commercial models only

# --- Episode assembly (Phase 4) ---------------------------------------------------
# auto   = encode a real 1080p H.264/AAC MP4 with local FFmpeg when it is installed,
#          otherwise write the mock master manifest (default)
# ffmpeg = require FFmpeg (BUILD FINAL fails clearly if it is missing)
# mock   = always write the mock master manifest
ASSEMBLY_MODE=auto
# FFMPEG_PATH / FFPROBE_PATH above are also used by the app.
# TITLE_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# --- Cloud GPU (Phase 5) -------------------------------------------------------------
# REAL cloud generation needs BOTH lines below changed AND the in-app switches
# (Settings -> Cloud GPU -> "Cloud GPU enabled" and "Real generation enabled"),
# plus a saved API key. Keep the safe defaults until you have followed
# docs/RUNPOD_SETUP.md. (MOCK_GENERATION and ENABLE_CLOUD_GPU are at the top of this file.)
#
# Provider: runpod (implemented). vast / tensordock are placeholders that refuse to run.
CLOUD_GPU_PROVIDER=runpod
# Your RunPod API key. Easier and safer: leave this EMPTY and paste the key in
# Settings -> Cloud GPU (it is then stored only in DATA_DIR/secrets.json on this PC).
# Never share or commit a .env that contains a key.
RUNPOD_API_KEY=
# Optional Hugging Face token (only for gated models; the default models do not need one).
HF_TOKEN=
#
# HARD CAPS (rupees / minutes). Settings can go lower but never above these. Empty = no extra cap.
MAX_GPU_HOURLY_RATE=
SESSION_BUDGET=
IDLE_SHUTDOWN_MINUTES=10
MAX_GPU_LIFETIME_MINUTES=
# Never more than this many paid GPUs at once (default 1).
MAX_CONCURRENT_GPU_INSTANCES=1
# Optional: the cloud worker image (otherwise Settings -> Cloud GPU -> Advanced).
# CLOUD_WORKER_IMAGE=ghcr.io/<your-github-name>/ai-story-studio-worker:1.1.0
#
# Note: WORKER_AUTH_TOKEN above is ONLY for a local worker you run yourself. Cloud GPUs get
# a fresh random token for every session automatically; nothing to configure.
