# KATKEE backend configuration.
# Copy to .env for local development: cp .env.example .env

NODE_ENV=development
PORT=4000

PGHOST=localhost
PGPORT=5432
PGDATABASE=katkee_dev
PGUSER=katkee
PGPASSWORD=change_me

# HS256 signing secret for access/refresh tokens. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Where uploaded media is stored on local disk (Phase 3 — see
# backend/src/modules/media/storage.ts for why this isn't S3 yet).
# Defaults to <backend>/data/media if unset.
MEDIA_STORAGE_ROOT=
