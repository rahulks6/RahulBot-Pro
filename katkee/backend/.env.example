# KATKEE backend configuration.
# Copy to .env for local development: cp .env.example .env

NODE_ENV=development
PORT=4000

PGHOST=localhost
PGPORT=5432
PGDATABASE=katkee_dev
PGUSER=katkee
PGPASSWORD=change_me

# HS256 signing secret for access/refresh tokens. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Where uploaded media is stored on local disk (Phase 3 — see
# backend/src/modules/media/storage.ts for why this isn't S3 yet).
# Defaults to <backend>/data/media if unset.
MEDIA_STORAGE_ROOT=

# How long a published Story stays active (spec section 29: 24h in
# production). Defaults to 86400 if unset.
STORY_TTL_SECONDS=

# Phase 10: in-memory, single-process rate limiting (see
# src/http/rateLimiter.ts for why in-memory is the deliberate tradeoff
# here). Auth applies to signup/login/refresh combined, per IP; global
# applies to every request, per IP. Defaults: 10 auth requests per 15
# minutes, 600 requests per minute overall.
RATE_LIMIT_AUTH_WINDOW_MS=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_GLOBAL_WINDOW_MS=
RATE_LIMIT_GLOBAL_MAX=

# The one account that can grant/revoke moderator and admin access to
# everyone else, and that nothing in the app can ever demote or suspend
# (see scripts/seedPrimaryAdmin.ts). Sign up a normal account through the
# app first, put its email here, then run `npm run seed:admin` once.
# Leave unset if you don't need a primary admin yet (e.g. every test run).
PRIMARY_ADMIN_EMAIL=
