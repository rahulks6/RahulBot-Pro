# AI Story Studio — example environment. Copy to `.env` (never commit `.env`).

# Mock generation is ON by default. While true, no GPU is provisioned, no paid
# API is called and every generated asset is a clearly labelled placeholder.
MOCK_GENERATION=true

# Cloud GPU provisioning. Phase 1 contains NO real cloud provider; this flag is
# a second, independent gate for future phases and must stay false.
ENABLE_CLOUD_GPU=false

# Local web UI. Bind to loopback only; this is a private, single-user tool.
HOST=127.0.0.1
PORT=3000

# Where the SQLite database, media assets, logs and backups are stored.
DATA_DIR=./data

# Probability (0..1) that a mock generation attempt fails, to exercise the
# retry / failure-cleanup paths. 0 disables random mock failures.
MOCK_FAILURE_RATE=0

# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Local AI worker (Phase 2) ---------------------------------------------------
# Leave WORKER_URL empty to use the in-process mock providers. To use the Python
# worker (worker/), start it with `npm run worker` and set both values below.
# The SAME token must be given to the worker process. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_URL=
WORKER_AUTH_TOKEN=
WORKER_TIMEOUT_SEC=1800

# Worker process settings (read by `npm run worker`):
# WORKER_HOST=127.0.0.1
# WORKER_PORT=8765
# WORKER_DATA_DIR=./worker-data
# WORKER_MOCK_MODELS=true
# WORKER_MAX_UPLOAD_MB=64
# WORKER_MAX_CONCURRENT_JOBS=1
# WORKER_JOB_TIMEOUT_SEC=1800
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Phase 3 — real open-source models (see docs/BENCHMARKING.md):
# WORKER_MODELS_FILE=./worker/models.json      # copy of worker/models.example.json, reviewed
# WORKER_MODEL_CACHE_DIR=~/.cache/ais-models   # model downloads
# WORKER_ALLOW_NONCOMMERCIAL=false             # true = private evaluation of non-commercial models only

# --- Episode assembly (Phase 4) ---------------------------------------------------
# auto   = encode a real 1080p H.264/AAC MP4 with local FFmpeg when it is installed,
#          otherwise write the mock master manifest (default)
# ffmpeg = require FFmpeg (BUILD FINAL fails clearly if it is missing)
# mock   = always write the mock master manifest
ASSEMBLY_MODE=auto
# FFMPEG_PATH / FFPROBE_PATH above are also used by the app.
# TITLE_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Future phases only (leave empty). Cloud credentials stay in this app's server
# process and are never sent to the browser or to GPU workers.
# RUNPOD_API_KEY=
# TENSORDOCK_API_KEY=
# VAST_API_KEY=
