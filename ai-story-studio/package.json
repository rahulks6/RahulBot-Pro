{
  "name": "ai-story-studio",
  "version": "1.3.1",
  "private": true,
  "description": "Private, local-first AI Story Studio: original animated series in English and Hinglish, made with real open-source AI on a rented RunPod GPU (paste your key; nothing else to set up). Placeholder generation exists only for automated tests.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/web/server.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/src/web/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "node --disable-warning=ExperimentalWarning node_modules/eslint/bin/eslint.js . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "migrate": "node --disable-warning=ExperimentalWarning src/cli/migrate.ts",
    "seed": "node --disable-warning=ExperimentalWarning src/cli/seed-demo.ts",
    "check:image": "node --disable-warning=ExperimentalWarning src/cli/check-worker-image.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "worker": "cd worker && python3 -m ais_worker",
    "check:worker": "cd worker && ruff check . && ruff format --check . && mypy && pytest"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2"
  }
}
